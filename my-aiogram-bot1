def menu(items, pref, flag=False):
    kb, cat = [], "stars" if "stars" in pref else ("prem" if "prem" in pref else "robux")
    for k, v in items.items():
        s, p = v["stock"], v["price"]
        fp, disc = g_p(cat, k, p)
        if s > 0:
            mn = {'1m':'1 oylik','3m':'3 oylik','6m':'6 oylik','1y':'1 yillik'}.get(k, k)
            ds = f" 🔥 -{disc}%" if disc > 0 else ""
            lbl = f"⚡ {k} R$ — {f_n(fp)} so'm{ds} (📦 {s})" if flag else (f"⭐ {f_n(int(k))} yulduz — {f_n(fp)} so'm{ds} (📦 {s})" if "stars" in pref else f"💎 Premium {mn} — {f_n(fp)} so'm{ds} (📦 {s})")
            kb.append([IKB(text=lbl, callback_data=f"{pref}_{k}_{fp}")])
        else: kb.append([IKB(text=f"❌ {k} — Yo'q", callback_data=f"no_{k}")])
    return IKM(inline_keyboard=kb + [[IKB(text="🔙 Orqaga", callback_data="back")]])

