@dp.message(F.text & ~F.text.startswith("/"))
async def text_h(m: Message, state: FSMContext):
    uid = m.from_user.id
    if g_u(uid).get("blocked", False) and uid != AID: return await m.answer("❌ Bloklangansiz!")
    if m.reply_to_message and (uid == AID or uid in a_auth) and "🆔" in m.reply_to_message.text:
        try:
            tid = int([x for x in m.reply_to_message.text.split() if x.isdigit()][0])
            await bot.send_message(tid, f"📞 Admin:\n\n{m.text}"); return await m.answer("✅ Yuborildi!")
        except: pass
    if uid in w_codes:
        w_codes.remove(uid); await m.answer("✅ Yuborildi!")
        try: await bot.send_message(AID, f"🔑 Kod ({m.from_user.full_name}): {m.text.strip()}")
        except: pass
        return
    t = m.text.lower()
    if "admin panel" in t: await state.set_state(FSM.pwd); return await m.answer("🔐 Parol:")
    if "promokod" in t: await state.set_state(FSM.prm); return await m.answer("🎟 Kodni kiriting:")
    if "chegirma" in t or "flash" in t:
        txt, has, now = "🔥 Chegirmalar:\n\n", False, time.time()
        for (c, k), v in list(sales.items()):
            if now < v["exp"]: has = True; txt += f"⚡ {c.upper()} {k} — {v['disc']}% (⏳ {int((v['exp']-now)/60)}m)\n"
            else: del sales[(c, k)]
        return await m.answer(txt if has else "🔥 Hozircha yo'q!", reply_markup=i_kb())
    chk_u(uid)
    if "star" in t: await m.answer("⭐ Yulduz:", reply_markup=menu(STARS, "buy_s"))
    elif "prem" in t: await m.answer("💎 Premium:", reply_markup=menu(PREM, "buy_p"))
    elif "robux" in t: await m.answer("⚡ Robux:", reply_markup=menu(ROB, "buy_r", True))
    elif "balans" in t or "to'ldirish" in t: await pay_menu(m, m.from_user)
    elif "hisob" in t or "profil" in t: await prof(m, m.from_user)
    elif "qo'llanma" in t: await m.answer("📖 Balansni to'ldirib xarid qiling.")
    elif "admin" in t: await m.answer(f"📞 Admin: {AUN}")

