def ldb(fn=DB): return json.load(open(fn, "r", encoding="utf-8")) if os.path.exists(fn) else {}
def sdb(d, fn=DB): json.dump(d, open(fn, "w", encoding="utf-8"), indent=2, ensure_ascii=False)
def chk_u(uid):
    db, u = ldb(), str(uid)
    if u not in db: db[u] = {"balance": 0, "blocked": False}; sdb(db)
def g_u(uid): return ldb().get(str(uid), {"balance": 0, "blocked": False})
def add_b(uid, amt):
    db, u = ldb(), str(uid)
    db.setdefault(u, {"balance": 0, "blocked": False})
    db[u]["balance"] += amt; sdb(db)
    return db[u]["balance"]
def f_n(v): return f"{v:,}".replace(",", " ")
def g_p(cat, key, op):
    if (cat, key) in sales:
        s = sales[(cat, key)]
        if time.time() < s["exp"]: return int(op * (100 - s["disc"]) / 100), s["disc"]
        else: del sales[(cat, key)]
    return op, 0

